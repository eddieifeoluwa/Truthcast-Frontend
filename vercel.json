{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.{jpg,jpeg,png,gif,svg,ico,webp,avif}", "use": "@vercel/static" },
    { "src": "*.{css,js}", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/dashboard.html", "dest": "/dashboard.html" },
    { "src": "/login.html", "dest": "/login.html" },
    { "src": "/report", "dest": "/report.html" },
    { "src": "/report/(.*)", "dest": "/report.html" },
    { "src": "/report.html", "dest": "/report.html" },
    { "src": "/terms",   "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms.html",   "dest": "/terms.html" },
    { "src": "/privacy.html", "dest": "/privacy.html" },
    { "src": "/starter",      "dest": "/starter.html" },
    { "src": "/starter.html", "dest": "/starter.html" },
    { "src": "/whatsapp-hero.jpg", "dest": "/whatsapp-hero.jpg" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/favicon-(.*).png", "dest": "/favicon-$1.png" },
    { "src": "/apple-touch-icon.png", "dest": "/apple-touch-icon.png" },
    { "src": "/", "dest": "/index.html" }
  ]
}
